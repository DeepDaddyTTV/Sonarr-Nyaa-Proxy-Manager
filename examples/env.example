# Rename locally to .env. Never publish your populated copy.
IMAGE_TAG=latest
AUTH_USERNAME=proxy-admin
AUTH_PASSWORD=replace-with-a-long-unique-password
AUTH_COOKIE_SECURE=false
# Blank connection fields are editable in Settings.
PROWLARR_URL=
PROWLARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
PROXY_PUBLIC_URL=
PROXY_API_KEY=
# Optional existing Sonarr tag labels for Standard-numbered anime.
SONARR_ANIME_TAG=
SONARR_TV_TAG=
PROWLARR_DISCOVER_ON_START=false
UPSTREAM_INDEXERS_JSON=[]
