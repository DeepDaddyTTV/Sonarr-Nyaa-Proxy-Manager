# Save privately as mcp.env, not as the manager's .env.
# Docker Desktop: reach the manager's published host port.
MCP_MANAGER_URL=http://host.docker.internal:8787
MCP_AUTH_USERNAME=replace-with-your-manager-login
MCP_AUTH_PASSWORD=replace-with-your-manager-password
MCP_ALLOW_WRITES=false
# Optional keys loaded by set_connection, without putting secrets into AI chat.
MCP_SONARR_API_KEY=
MCP_PROWLARR_API_KEY=
MCP_PROXY_API_KEY=
